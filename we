# ============================================================
# 5. Inference 모드
# ============================================================

model.eval()


# ============================================================
# 6. Tokenize
# ============================================================

def tokenize(text):

    return text.lower().split()


# ============================================================
# 7. Encode
# ============================================================

def encode(tokens):

    unk_id = token_to_id["<unk>"]

    return [
        token_to_id.get(
            token,
            unk_id
        )
        for token in tokens
    ]


# ============================================================
# 8. Decode
# ============================================================

def decode(ids):

    return [
        id_to_token.get(
            token_id,
            "<unk>"
        )
        for token_id in ids
    ]


# ============================================================
# 9. 기본 다음 Token 예측
# ============================================================

def predict_next_token(
    model,
    text
):

    tokens = tokenize(text)

    input_ids = encode(tokens)

    x = torch.tensor(
        [input_ids],
        dtype=torch.long
    )


    # --------------------------------------------------------
    # Forward
    # --------------------------------------------------------

    logits = model(x)


    # 마지막 위치의 logits
    last_logits = logits[:, -1, :]


    # --------------------------------------------------------
    # 가장 높은 확률의 Token 선택
    # --------------------------------------------------------

    predicted_id = torch.argmax(
        last_logits,
        dim=-1
    ).item()


    return id_to_token[predicted_id]


