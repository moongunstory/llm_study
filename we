import torch
from torch import nn


# ============================================================
# 1. Vocabulary
# ============================================================

vocab = {
    "<unk>": 0,
    "hello": 1,
    "world": 2,
    "machine": 3,
    "learning": 4,
    "deep": 5,
    "is": 6,
    "powerful": 7,
    "friend": 8,
}


token_to_id = vocab

id_to_token = {
    token_id: token
    for token, token_id in token_to_id.items()
}


vocab_size = len(vocab)


# ============================================================
# 2. Language Model
# ============================================================

class LanguageModel(nn.Module):

    def __init__(
        self,
        vocab_size,
        embedding_dim,
        hidden_dim
    ):
        super().__init__()

        self.embedding = nn.Embedding(
            vocab_size,
            embedding_dim
        )

        self.rnn = nn.RNN(
            input_size=embedding_dim,
            hidden_size=hidden_dim,
            batch_first=True
        )

        self.linear = nn.Linear(
            hidden_dim,
            vocab_size
        )

    def forward(self, x):

        x = self.embedding(x)

        output, hidden = self.rnn(x)

        logits = self.linear(output)

        return logits


# ============================================================
# 3. 모델 생성
# ============================================================

embedding_dim = 32

hidden_dim = 64


model = LanguageModel(
    vocab_size=vocab_size,
    embedding_dim=embedding_dim,
    hidden_dim=hidden_dim
)


# ============================================================
