# ============================================================
# 22. Inference 함수
# ============================================================

def inference(
    prompt,
    max_new_tokens=10,
    temperature=1.0,
    top_k=3
):

    model.eval()


    generated_tokens = tokenize(
        prompt
    )


    for _ in range(max_new_tokens):

        input_ids = encode(
            generated_tokens
        )


        x = torch.tensor(
            [input_ids],
            dtype=torch.long
        )


        # ----------------------------------------------------
        # Forward
        # ----------------------------------------------------

        logits = model(x)


        # ----------------------------------------------------
        # 마지막 Token의 logits
        # ----------------------------------------------------

        logits = logits[:, -1, :]


        # ----------------------------------------------------
        # Temperature
        # ----------------------------------------------------

        logits = (
            logits
            / temperature
        )


        # ----------------------------------------------------
        # Top-K
        # ----------------------------------------------------

        if top_k is not None:

            top_values, top_indices = torch.topk(
                logits,
                k=top_k
            )


            filtered_logits = torch.full_like(
                logits,
                float("-inf")
            )


            filtered_logits.scatter_(
                1,
                top_indices,
                top_values
            )


            logits = filtered_logits


        # ----------------------------------------------------
        # Softmax
        # ----------------------------------------------------

        probabilities = torch.softmax(
            logits,
            dim=-1
        )


        # ----------------------------------------------------
        # Sampling
        # ----------------------------------------------------

        next_token_id = torch.multinomial(
            probabilities,
            num_samples=1
        ).item()


        next_token = id_to_token[
            next_token_id
        ]


        generated_tokens.append(
            next_token
        )


    return " ".join(
        generated_tokens
    )


