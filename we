# ============================================================
# 11. Softmax
# ============================================================

def get_probabilities(
    model,
    text
):

    tokens = tokenize(text)

    input_ids = encode(tokens)

    x = torch.tensor(
        [input_ids],
        dtype=torch.long
    )


    logits = model(x)

    last_logits = logits[:, -1, :]


    probabilities = torch.softmax(
        last_logits,
        dim=-1
    )


    return probabilities


