for token_id, probability in enumerate(
    probabilities[0]
):

    token = id_to_token[token_id]

    print(
        f"{token:10s} "
        f"{probability.item():.6f}"
    )


# ============================================================
# 12. Top-K Sampling
# ============================================================

def top_k_sampling(
    model,
    text,
    k=3
):

    probabilities = get_probabilities(
        model,
        text
    )


    # --------------------------------------------------------
    # 가장 확률이 높은 K개 Token
    # --------------------------------------------------------

    top_probabilities, top_ids = torch.topk(
        probabilities,
        k=k,
        dim=-1
    )


    # --------------------------------------------------------
    # K개 Token의 확률을 다시 정규화
    # --------------------------------------------------------

    top_probabilities = (
        top_probabilities
        / top_probabilities.sum(
            dim=-1,
            keepdim=True
        )
    )


    # --------------------------------------------------------
    # 확률에 따라 하나 선택
    # --------------------------------------------------------

    selected_index = torch.multinomial(
        top_probabilities,
        num_samples=1
    )


    selected_id = top_ids[
        0,
        selected_index[0, 0]
    ].item()


    return id_to_token[selected_id]


# ============================================================
# 13. Temperature
# ============================================================

def get_temperature_probabilities(
    model,
    text,
    temperature=1.0
):

    tokens = tokenize(text)

    input_ids = encode(tokens)

    x = torch.tensor(
        [input_ids],
        dtype=torch.long
    )


    logits = model(x)

    last_logits = logits[:, -1, :]


    # --------------------------------------------------------
    # Temperature 적용
    # --------------------------------------------------------

    scaled_logits = (
        last_logits
        / temperature
    )


    probabilities = torch.softmax(
        scaled_logits,
        dim=-1
    )


    return probabilities


# ============================================================
# 14. Temperature를 사용한 Sampling
# ============================================================

def temperature_sampling(
    model,
    text,
    temperature=1.0
):

    probabilities = get_temperature_probabilities(
        model,
        text,
        temperature
    )


    selected_id = torch.multinomial(
        probabilities,
        num_samples=1
    ).item()


    return id_to_token[selected_id]


# ============================================================
# 15. Text Generation
# ============================================================

def generate(
    model,
    prompt,
    max_new_tokens=10,
    temperature=1.0,
    top_k=None
):

    model.eval()


    # --------------------------------------------------------
    # Prompt Token
    # --------------------------------------------------------

    generated_tokens = tokenize(prompt)


    # --------------------------------------------------------
    # Token 생성
    # --------------------------------------------------------

    for _ in range(max_new_tokens):

        input_ids = encode(
            generated_tokens
        )


        x = torch.tensor(
            [input_ids],
            dtype=torch.long
        )


        # ----------------------------------------------------
        # Forward
        # ----------------------------------------------------

        logits = model(x)


        # 마지막 위치의 logits
        next_token_logits = logits[
            :, -1, :
        ]


        # ----------------------------------------------------
        # Temperature
        # ----------------------------------------------------

        next_token_logits = (
            next_token_logits
            / temperature
        )


        # ----------------------------------------------------
        # Top-K
        # ----------------------------------------------------

        if top_k is not None:

            values, indices = torch.topk(
                next_token_logits,
                k=top_k
            )


            filtered_logits = torch.full_like(
                next_token_logits,
                float("-inf")
            )


            filtered_logits.scatter_(
                1,
                indices,
                values
            )


            next_token_logits = (
                filtered_logits
            )


        # ----------------------------------------------------
        # 확률
        # ----------------------------------------------------

        probabilities = torch.softmax(
            next_token_logits,
            dim=-1
        )


        # ----------------------------------------------------
        # Sampling
        # ----------------------------------------------------

        next_token_id = torch.multinomial(
            probabilities,
            num_samples=1
        ).item()


        next_token = id_to_token[
            next_token_id
        ]


        generated_tokens.append(
            next_token
        )


    return generated_tokens


